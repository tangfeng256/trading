{
    "version": "0.2.0",

    // ── HOW TO CUSTOMISE ────────────────────────────────────────────────────
    // 1. Point --config at your real config file (edit the "args" array below).
    // 2. Add or remove --set lines to override individual config fields, e.g.:
    //      "--set", "ib.paper_port=7497",
    //      "--set", "runtime.symbols=NVDA,TSLA"
    // 3. For absorption/pullback you can also override --port and --client-id
    //    directly in args without needing a config change.
    // ────────────────────────────────────────────────────────────────────────

    "configurations": [

        // ════════════════════════════════════════════════════════════════════
        // ORCHESTRATOR  (all three strategies on one account)
        // ════════════════════════════════════════════════════════════════════

        {
            "name": "▶  Orchestrator — Paper",
            "type": "python",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "args": [
                "orchestrator", "paper",
                "--config", "configs/orchestrator.json",
                "--set", "ib.paper_port=7497"
            ],
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}/src" },
            "console": "integratedTerminal",
            "justMyCode": true
        },

